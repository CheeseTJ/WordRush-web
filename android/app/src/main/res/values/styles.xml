<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!--
      主界面主题。
      用 DayNight 会让系统深色模式下把窗口背景刷成近黑，而 App 本身是固定的
      米色粘土风（body 背景 #FFF6EA），切换瞬间会闪一下黑。显式指定 Light。

      ⚠️ 这里【不设】statusBarColor / navigationBarColor / windowBackground：
      WebView 已铺满全屏（含状态栏区域），系统栏必须是透明的，网页的渐变背景
      才能一直画到屏幕顶端。之前写 @color/brand_cream 会让状态栏区域被刷成
      一块纯米色，与下方渐变形成一道可见的接缝——那正是「任务栏有底色」的来源。
      透明由 MainActivity 在 setContentView 之后显式设置（主题里的值会在
      窗口 attach 后被重新应用，只改主题不够）。
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- 系统栏图标用深色（浅色页面背景），与 App 固定的浅色主题一致 -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- 首帧兜底底色：WebView 画出第一帧前会短暂露出，用页面同色避免白闪。
             它只影响「还没有内容」的那一瞬间，不影响系统栏透明。 -->
        <item name="android:windowBackground">@color/brand_cream</item>
    </style>

    <!--
      启动画面。
      这里只做「一张纯色底 + 居中图标」，不引用 @drawable/splash 位图——
      位图必须按每个机型的屏幕比例准备，缺失的密度目录会回落到 drawable/splash.png
      （480x320 横图），在竖屏下被拉伸成一个明显错位的色块。
      改用 windowSplashScreenBackground + windowSplashScreenAnimatedIcon，
      由系统按当前屏幕密度与形状自行合成，任何机型都不会出现错位。
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_cream</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <!-- 图标在 Android 12+ 会被裁成圆形安全区，加一层品牌绿垫底更饱满 -->
        <item name="windowSplashScreenIconBackgroundColor">@color/brand_green</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <!-- Android 11 及以下的兜底：只给纯色，不给位图 -->
        <item name="android:windowBackground">@color/brand_cream</item>
    </style>
</resources>